<Window x:Class="Ray.MemoryManagerSetup.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Memory Manager 安裝程式" Width="620" Height="420" WindowStartupLocation="CenterScreen" ResizeMode="NoResize" Background="#090D14" Foreground="#EEF4FF">
<Grid Margin="34"><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><StackPanel><TextBlock Text="安裝 Memory Manager" FontSize="30" FontWeight="SemiBold"/><TextBlock Text="這不是模擬安裝。程式會真的複製到你的使用者程式目錄、建立開始功能表捷徑，並加入 Windows 的解除安裝清單。" TextWrapping="Wrap" Foreground="#9BA8BC" Margin="0,14,0,22" FontSize="15"/><Border Background="#121A27" Padding="18" CornerRadius="10"><StackPanel><TextBlock Text="安裝位置"/><TextBlock x:Name="PathText" Foreground="#77B4FF" Margin="0,5,0,10"/><CheckBox x:Name="DesktopCheck" IsChecked="True" Content="建立桌面捷徑" Foreground="#EEF4FF"/><TextBlock Text="再次執行安裝程式會進入 Repair（修復）模式。解除安裝會移除程式檔與捷徑。" TextWrapping="Wrap" Foreground="#9BA8BC" Margin="0,12,0,0"/></StackPanel></Border><ProgressBar x:Name="Progress" Height="12" Margin="0,20,0,0" Minimum="0" Maximum="100"/><TextBlock x:Name="StatusText" Foreground="#9BA8BC" Margin="0,8,0,0"/></StackPanel><StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right"><Button x:Name="UninstallButton" Content="解除安裝" Margin="5" Padding="18,9" Click="Uninstall_Click"/><Button x:Name="InstallButton" Content="安裝 / 修復" Margin="5" Padding="18,9" Click="Install_Click"/></StackPanel></Grid>
</Window>
